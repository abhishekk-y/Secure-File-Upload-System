# These are examples. The application reads operating-system environment variables,
# not this file automatically. Set them in your shell or process manager.
HOST=127.0.0.1
PORT=5000
# Limit self-service registrations for a small local installation.
MAX_USERS=5
# Exact hostnames accepted by the application.
TRUSTED_HOSTS=localhost,127.0.0.1
# Enable when browser requests reach the app through HTTPS.
APP_HTTPS=0
# Absolute, private directory; do not put it inside app/static.
# DATA_DIR=/srv/secure-vault/data
# Absolute path to the real ClamAV executable with an updated signature database.
# CLAMSCAN_PATH=/usr/bin/clamscan
REQUIRE_SCAN=1
# memory:// is for a single process; install the redis extra before using Redis.
RATELIMIT_STORAGE_URI=memory://
